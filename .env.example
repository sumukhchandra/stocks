# Environment Configuration for NSE 5-Minute Systematic Trading System

# Application
APP_ENV=production
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-secure-random-key-in-production

# Market Data & Broker
BROKER_MODE=PAPER  # PAPER or LIVE
KITE_API_KEY=your_zerodha_kite_api_key_here
KITE_ACCESS_TOKEN=your_zerodha_kite_access_token_here

# Database
DATABASE_URL=sqlite:///database/trading_system.db
# DATABASE_URL=postgresql://user:password@localhost:5432/trading_db

# Risk Parameters
MAX_PORTFOLIO_DRAWDOWN_PCT=3.0
MAX_POSITIONS=5
MAX_SECTOR_EXPOSURE_PCT=40.0
MIN_CONFIDENCE_THRESHOLD=0.60
MIN_NET_PROFIT_PCT=0.005
MAX_GROSS_LOSS_PCT=0.008

# Server
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=8501
